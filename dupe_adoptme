-- 10. Animación de carga exacta de 20 segundos
local duracionTotal = 20
local tiempoInicio = tick()

local conexion
conexion = RunService.RenderStepped:Connect(function()
    local tiempoActual = tick() - tiempoInicio
    local progreso = math.clamp(tiempoActual / duracionTotal, 0, 1)
    local porcentajeInt = math.floor(progreso * 100)
    
    -- Actualizar barra y texto
    barFill.Size = UDim2.new(progreso, 0, 1, 0)
    percentLabel.Text = porcentajeInt .. "%"
    
    -- Al llegar al 100%
    if progreso >= 1 then
        conexion:Disconnect()
        task.wait(0.5)
        screenGui:Destroy()
        
        print("¡Pantalla de carga completada con éxito!")
    end
end)

  
